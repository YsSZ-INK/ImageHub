# ===== 基础 =====
# 站点对外访问地址（用于生成站内链接、OAuth 回调等）
SITE_URL="http://localhost:3000"
# 服务端口绑定地址：默认 127.0.0.1 仅本机可访问（外网打不开）；
# 需要外网直接访问时改为 0.0.0.0（此时建议用防火墙/安全组限制来源，或改走反向代理）
# BIND_IP="127.0.0.1"
# 宿主机监听端口
# PORT=3000
# NextAuth 加密密钥：openssl rand -base64 32 生成
AUTH_SECRET="dev-secret-change-me-0123456789abcdef"
AUTH_TRUST_HOST=true

# ===== 数据库 =====
# 本地开发：SQLite（无需 Docker）；Docker 部署时由 compose 注入 PostgreSQL 地址
DATABASE_URL="file:./dev.db"

# ===== 存储 =====
# 本地磁盘存储（相对项目根目录）
LOCAL_STORAGE_DIR="./storage"

# ===== 上传限制 =====
# 单文件大小上限（MB）——部署级天花板：实际生效 = min(界面设置, 此值)，最大 512
MAX_UPLOAD_MB="512"
# 是否自动将 jpg/png 转 WebP 存储
CONVERT_TO_WEBP="false"

# ===== Redis（可选） =====
# 未配置时限流降级为内存实现；Docker 部署时由 compose 注入
# REDIS_URL="redis://localhost:6379"

# ===== 邮件（可选） =====
# 验证 / 重置邮件通过后台「站点设置 → 邮件配置」里的 SMTP 发送；
# 未配置时回退为打印到服务端控制台，无需环境变量
