# ===== 基础 =====
# 站点对外访问地址（用于生成站内链接、OAuth 回调等）
SITE_URL="http://localhost:3000"
# NextAuth 加密密钥：openssl rand -base64 32 生成
AUTH_SECRET="dev-secret-change-me-0123456789abcdef"
AUTH_TRUST_HOST=true

# ===== 数据库 =====
# 本地开发：SQLite（无需 Docker）；Docker 部署时由 compose 注入 PostgreSQL 地址
DATABASE_URL="file:./dev.db"

# ===== 存储驱动 =====
# local：本地磁盘（开发预览）；s3：S3 兼容对象存储（MinIO/R2/OSS/S3）
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"

# ===== S3 兼容存储（STORAGE_DRIVER=s3 时生效，桶必须为私有） =====
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="imagehub"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# 上传/删除使用的内部端点（可选，MinIO 集群与内网直连场景使用）
# S3_UPLOAD_ENDPOINT=

# ===== 上传限制 =====
# 单文件大小上限（MB）
MAX_UPLOAD_MB="20"
# 是否自动将 jpg/png 转 WebP 存储
CONVERT_TO_WEBP="false"

# ===== Redis（可选） =====
# 未配置时限流降级为内存实现；Docker 部署时由 compose 注入
# REDIS_URL="redis://localhost:6379"

# ===== 邮件（可选） =====
# 开发环境验证邮件直接打印到服务端控制台；生产可接入 Resend/SMTP
# SMTP_URL=
# RESEND_API_KEY=
