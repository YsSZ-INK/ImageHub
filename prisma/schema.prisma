// 生产环境 schema（PostgreSQL，Docker 部署使用）
// 注意：为兼容 SQLite 开发预览，状态字段统一使用 String + 应用层校验，而非 Prisma enum

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String    @unique // 用户名，用于 /u/[username] 主页
  avatarUrl     String?
  role          String    @default("USER") // USER | ADMIN
  storageQuota  BigInt    @default(5368709120) // 默认 5GB
  storageUsed   BigInt    @default(0)
  status        String    @default("ACTIVE") // ACTIVE | BANNED
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  images    Image[]
  albums    Album[]
  posts     Post[]
  postComments PostComment[]
  activityLogs ActivityLog[]
  apiTokens ApiToken[]
  tokens    Token[]
  uploadSessions UploadSession[]
  sentAccessRequests     ImageAccessRequest[] @relation("accessRequestsSent")
  receivedAccessRequests ImageAccessRequest[] @relation("accessRequestsReceived")
  commentReplyTargets    PostComment[]        @relation("CommentReplyTarget")
}

model Image {
  id         String    @id @default(cuid())
  userId     String
  filename   String
  storageKey String
  thumbKey   String
  mimeType   String
  size       Int
  width      Int
  height     Int
  sha256     String
  blurhash   String?
  visibility String    @default("PUBLIC") // PUBLIC | PRIVATE | UNLISTED（均仅登录用户可达）
  status     String    @default("PUBLISHED") // PUBLISHED 已发布 | PENDING 待审核（审核通过才进画廊，管理员上传免审）
  storage    String    @default("local") // 文件实际存放位置：local 本地磁盘 | r2 Cloudflare R2（按图片记录，切换驱动不影响旧文件）
  albumId    String?
  postId     String? // 关联的图文动态（发布到动态时挂上）
  deletedAt  DateTime? // 软删除，回收站保留 30 天
  createdAt  DateTime  @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  album    Album?     @relation(fields: [albumId], references: [id], onDelete: SetNull)
  post     Post?      @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sha256])
  @@index([visibility, createdAt])
  @@index([albumId])
  @@index([postId])
}

// 图文动态（朋友圈式 feed：文字 + 多图）
model Post {
  id        String   @id @default(cuid())
  userId    String
  caption   String   @default("")
  createdAt DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images   Image[]
  comments PostComment[]

  @@index([createdAt])
}

// 动态评论：登录用户可评论；删除限本人或管理员。
// 回复：parentId 指向所属顶层评论（一层线程结构，回复回复时归并到同一顶层）；replyToUserId 记录被回复人，展示「回复 @某人」
model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  parentId      String?
  replyToUserId String?

  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     PostComment[] @relation("CommentReplies")
  replyToUser User?         @relation("CommentReplyTarget", fields: [replyToUserId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([parentId])
}

// 站点操作日志：管理员在「站点设置 → 操作日志」查看（谁在什么时间做了什么）
model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  detail    String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?

  @@index([createdAt])
  @@index([userId])
}

model Album {
  id           String   @id @default(cuid())
  userId       String
  name         String
  description  String?
  slug         String
  coverImageId String?
  visibility   String   @default("PUBLIC")
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  images Image[]

  @@unique([userId, slug])
}

// 图片访问授权（申请-审批流）：A 向 B 申请浏览其图片，B 同意后 A 可浏览 B 的全部已发布图片（含 PRIVATE）
model ImageAccessRequest {
  id          String    @id @default(cuid())
  requesterId String // 申请人
  ownerId     String // 图片主人（审批人）
  status      String    @default("PENDING") // PENDING 待审批 | APPROVED 已授权 | REJECTED 已拒绝
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  requester User @relation("accessRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  owner     User @relation("accessRequestsReceived", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([requesterId, ownerId])
  @@index([ownerId, status])
  @@index([requesterId, status])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique // sha256(token)，明文只在创建时返回一次
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 分片上传会话：大文件（>16MB）切片上传的会话元数据；分片数据在本地磁盘 .chunks/{id}/ 下
// 断点续传以「分片文件是否落盘」为准，会话超 24h 未完成连同分片一并清理
model UploadSession {
  id          String   @id @default(cuid())
  userId      String
  filename    String
  size        Int
  mimeType    String // 浏览器声明的 MIME（仅展示参考，服务端按魔数重新判定）
  totalChunks Int
  albumId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// 邮箱验证 / 找回密码 令牌
model Token {
  id        String    @id @default(cuid())
  userId    String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 站点设置（键值对）
model Setting {
  key   String @id
  value String
}

// 预留：未来接入 OAuth（数据库会话）时启用
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  @@unique([provider, providerAccountId])
}

// 预留：未来接入 OAuth（数据库会话）时启用
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
}
